# ==========================================================================
# Outbound: how the harness authenticates to the model providers
# ==========================================================================
# All optional. Leaving one unset does NOT disable that provider — each SDK
# walks its own credential chain, and these variables only override it.
#
# Anthropic resolution order (first match wins):
#   ANTHROPIC_API_KEY -> ANTHROPIC_AUTH_TOKEN -> ANTHROPIC_PROFILE / active
#   `ant auth login` profile -> workload identity federation -> default
#   profile in ~/.config/anthropic
#
# Careful: an exported-but-EMPTY ANTHROPIC_API_KEY shadows the rest of the
# chain. Unset it rather than setting it to "".
ANTHROPIC_API_KEY=
# ANTHROPIC_PROFILE=work          # named `ant auth login` profile
# ANTHROPIC_BASE_URL=

# OpenAI: an API key, or workload identity via the SDK's own env vars.
OPENAI_API_KEY=
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=
# OPENAI_BASE_URL=

# Prefer workload identity over a long-lived key on a real server. For
# Anthropic that means all of:
#   ANTHROPIC_FEDERATION_RULE_ID, ANTHROPIC_ORGANIZATION_ID,
#   ANTHROPIC_SERVICE_ACCOUNT_ID, and ANTHROPIC_IDENTITY_TOKEN_FILE
# (plus ANTHROPIC_WORKSPACE_ID when the federation rule spans workspaces).

# ==========================================================================
# Inbound: how callers authenticate to the harness
# ==========================================================================
# Exactly one of these two is required, or startup fails. That is deliberate:
# an unauthenticated harness lets anyone who can reach the port spend the
# provider credentials above, so it has to be asked for explicitly.

# Path to the principals file. Mint an entry with:
#   model-harness mint-key --id team-a --models claude-sonnet-5,gpt-5
HARNESS_PRINCIPALS_FILE=./principals.json

# ...or run with no inbound auth. Every caller then shares the "anonymous"
# principal and can read every anonymous session. Localhost only.
# HARNESS_ALLOW_ANONYMOUS=true

# ==========================================================================
# Tools
# ==========================================================================
# Which tools a caller may use is set per principal (`allowed_tools` in the
# principals file), not here. A principal with no `allowed_tools` gets the
# safe tools only — anything marked dangerous must be named explicitly.
#
# These two narrow the http_request tool further, for the whole deployment:

# Restrict outbound fetches to specific hosts. Empty = any public host.
# Internal, loopback, private and cloud-metadata addresses are always refused.
# HARNESS_TOOL_HTTP_ALLOWED_HOSTS=api.github.com,docs.python.org

# Allow POST/PUT/PATCH/DELETE from the http_request tool. Off by default:
# a model that can only read cannot change remote state by mistake.
# HARNESS_TOOL_HTTP_ALLOW_WRITES=false

# ==========================================================================
# Service
# ==========================================================================
HARNESS_HOST=127.0.0.1
HARNESS_PORT=8080

# Session TTL in seconds (0 disables expiry). Sessions are evicted lazily.
HARNESS_SESSION_TTL_SECONDS=86400

# Hard cap on stored turns per session; oldest user/assistant pairs are
# dropped once exceeded. 0 disables trimming.
HARNESS_SESSION_MAX_TURNS=200

# Per-request timeout handed to the provider SDKs, in seconds.
HARNESS_REQUEST_TIMEOUT_SECONDS=600
